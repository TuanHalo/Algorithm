---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import ProblemCard from '../components/ProblemCard.astro';
import { getTopicsWithCounts } from '../utils/topics';
import { withBase } from '../utils/url';

const lessons = await getCollection('learn');
const problems = (await getCollection('problems')).sort((a, b) =>
  b.data.dateCompleted.localeCompare(a.data.dateCompleted),
);

const topics = getTopicsWithCounts(lessons);
const recentProblems = problems.slice(0, 3);
---

<BaseLayout title="Home">
  <div class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero__content clay-card">
        <h1 class="hero__title">🧮 Algorithm Hub</h1>
        <p class="hero__subtitle">
          Learn algorithms through <strong>interactive visualizations</strong>,
          not walls of text.
        </p>
        <div class="hero__actions">
          <a href={withBase('/learn/')} class="clay-btn clay-btn--primary">
            📚 Start Learning
          </a>
          <a href={withBase('/problems/')} class="clay-btn">
            📝 Problem Journal
          </a>
        </div>
      </div>
    </section>

    <!-- Topics Grid -->
    <section class="section">
      <h2 class="section__title">📚 Algorithm Topics</h2>
      <div class="topic-grid">
        {topics.map((topic) => (
          <TopicCard
            name={topic.name}
            icon={topic.icon}
            color={topic.color}
            slug={topic.slug}
            count={topic.lessonCount}
            description={topic.description}
          />
        ))}
      </div>
    </section>

    <!-- Recent Problems -->
    <section class="section">
      <div class="section__header">
        <h2 class="section__title">📝 Recent Problems</h2>
        {problems.length > 0 && (
          <a href={withBase('/problems/')} class="clay-btn clay-btn--small">View all →</a>
        )}
      </div>

      {recentProblems.length > 0 ? (
        <div class="problem-grid">
          {recentProblems.map((problem) => (
            <ProblemCard
              title={problem.data.title}
              platform={problem.data.platform}
              difficulty={problem.data.difficulty}
              topics={problem.data.topics}
              slug={problem.slug}
              dateCompleted={problem.data.dateCompleted}
              timeComplexity={problem.data.timeComplexity}
              spaceComplexity={problem.data.spaceComplexity}
            />
          ))}
        </div>
      ) : (
        <div class="clay-card empty-state">
          <p>🚀 No problems solved yet. Start your journey!</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    margin-bottom: var(--space-3xl);
  }

  .hero__content {
    text-align: center;
    padding: var(--space-3xl) var(--space-xl);
  }

  .hero__title {
    font-size: 3rem;
    margin-bottom: var(--space-md);
  }

  .hero__subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 auto var(--space-xl);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .section {
    margin-bottom: var(--space-3xl);
  }

  .section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .section__header .section__title {
    margin-bottom: 0;
  }

  .section__title {
    margin-bottom: var(--space-xl);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero__title {
      font-size: 2rem;
    }
  }
</style>
