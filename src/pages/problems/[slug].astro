---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComplexityBadge from '../../components/ComplexityBadge.astro';
import Walkthrough from '../../components/Walkthrough.astro';
import { getWalkthrough, problemWalkthroughId } from '../../lib/walkthrough/registry';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const problems = await getCollection('problems');
  return problems.map((problem) => ({
    params: { slug: problem.slug },
    props: { problem },
  }));
}

interface Props {
  problem: CollectionEntry<'problems'>;
}

const { problem } = Astro.props;
const { Content } = await problem.render();

const platformEmoji: Record<string, string> = {
  leetcode: '🟠',
  hackerrank: '🟢',
  codeforces: '🔵',
  other: '🟣',
};

const optimalApproach =
  problem.data.approaches?.find((a) => a.isOptimal) ?? problem.data.approaches?.[0];
const displayTime = problem.data.timeComplexity ?? optimalApproach?.timeComplexity;
const displaySpace = problem.data.spaceComplexity ?? optimalApproach?.spaceComplexity;
const approaches = problem.data.approaches ?? [];
const walkthroughId = problemWalkthroughId(problem.slug);
const hasWalkthrough = getWalkthrough(walkthroughId) !== undefined;
const usesTags = hasWalkthrough ? (optimalApproach?.tags ?? []).filter((tag) => tag.topic) : [];
---

<BaseLayout title={problem.data.title}>
  <div class="container problem-container">
    <nav class="breadcrumb">
      <a href={withBase('/problems/')}>📝 Problem Journal</a>
      <span>/</span>
      <span>{problem.data.title}</span>
    </nav>

    <header class="clay-section problem-header">
      <div class="problem-header__top">
        <div class="problem-header__badges">
          <span class="clay-badge">
            {platformEmoji[problem.data.platform]} {problem.data.platform}
          </span>
          <span class={`clay-badge clay-badge--${problem.data.difficulty}`}>
            {problem.data.difficulty}
          </span>
          {problem.data.dateCompleted && (
            <span class="clay-badge">📅 {problem.data.dateCompleted}</span>
          )}
        </div>
        <a
          href={problem.data.problemUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="clay-btn clay-btn--small clay-btn--primary"
        >
          🔗 Open Problem ↗
        </a>
      </div>

      <h1 class="problem-header__title">{problem.data.title}</h1>

      <div class="problem-header__footer">
        {displayTime && displaySpace && (
          <ComplexityBadge
            time={displayTime}
            space={displaySpace}
          />
        )}
        <div class="problem-header__topics">
          {problem.data.topics.map((topic) => (
            <span class="clay-badge clay-badge--complexity">{topic}</span>
          ))}
        </div>
      </div>
      {usesTags.length > 0 && (
        <div class="problem-header__uses">
          <span class="problem-header__uses-label">Uses:</span>
          {usesTags.map((tag) => (
            <a href={withBase(`/learn/${tag.topic}/${tag.slug ? tag.slug + '/' : ''}`)} class="clay-badge clay-badge--tag clay-badge--link">
              🏷️ {tag.label} ↗
            </a>
          ))}
        </div>
      )}
    </header>

    {!hasWalkthrough && approaches.length > 0 && (
      <section class="clay-section problem-approaches">
        <h2 class="problem-approaches__title">💡 Solution Approaches</h2>
        <div class="problem-approaches__list">
          {approaches.map((approach) => (
            <div class={`approach-card clay-card ${approach.isOptimal ? 'approach-card--optimal' : ''}`}>
              <div class="approach-card__header">
                <div class="approach-card__title-row">
                  <h3 class="approach-card__name">{approach.name}</h3>
                  {approach.isOptimal && (
                    <span class="clay-badge clay-badge--optimal">⭐ Optimal</span>
                  )}
                </div>
                <div class="approach-card__complexities">
                  <span class="clay-badge clay-badge--complexity">⏱️ {approach.timeComplexity}</span>
                  <span class="clay-badge clay-badge--complexity">💾 {approach.spaceComplexity}</span>
                </div>
              </div>
              {approach.summary && (
                <p class="approach-card__summary">{approach.summary}</p>
              )}
              {approach.tags && approach.tags.length > 0 && (
                <div class="approach-card__tags">
                  {approach.tags.map((tag) =>
                    tag.topic ? (
                      <a
                        href={withBase(`/learn/${tag.topic}/${tag.slug ? tag.slug + '/' : ''}`)}
                        class="clay-badge clay-badge--tag clay-badge--link"
                      >
                        🏷️ {tag.label} ↗
                      </a>
                    ) : (
                      <span class="clay-badge clay-badge--tag">🏷️ {tag.label}</span>
                    )
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Animated Walkthrough (src/walkthroughs/problems/<slug>.ts) -->
    {hasWalkthrough && (
      <section class="problem-walkthrough">
        <Walkthrough id={walkthroughId} accent="var(--color-hashing)" />
      </section>
    )}

    <article class="clay-section markdown-body">
      <Content />
    </article>

    <nav class="problem-nav">
      <a href={withBase('/problems/')} class="clay-btn">
        ← All Problems
      </a>
    </nav>
  </div>
</BaseLayout>

<style>
  .problem-container {
    max-width: 920px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
  }

  .problem-header {
    margin-bottom: var(--space-xl);
  }

  .problem-header__uses {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .problem-header__uses-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .problem-header__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .problem-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    text-transform: capitalize;
  }

  .problem-header__title {
    margin-bottom: var(--space-md);
  }

  .problem-header__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .problem-header__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .problem-approaches {
    margin-bottom: var(--space-xl);
  }

  .problem-approaches__title {
    font-size: 1.3rem;
    margin-bottom: var(--space-md);
  }

  .problem-approaches__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .approach-card {
    padding: var(--space-md);
    background: var(--bg-card);
    border-radius: var(--border-radius-sm);
  }

  .approach-card--optimal {
    border-left: 4px solid #2e7d32;
    background: rgba(76, 175, 80, 0.04);
  }

  .approach-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .approach-card__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .approach-card__name {
    font-size: 1.1rem;
    margin: 0;
  }

  .approach-card__complexities {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .approach-card__summary {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: var(--space-xs) 0 var(--space-sm);
    line-height: 1.5;
  }

  .approach-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .clay-badge--optimal {
    background: rgba(76, 175, 80, 0.2);
    color: #2e7d32;
    font-weight: 600;
  }

  .clay-badge--tag {
    font-size: 0.8rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: var(--shadow-clay-subtle);
    color: var(--text-primary);
  }

  .clay-badge--link {
    text-decoration: none;
    color: #1b6b50;
    font-weight: 600;
    transition: transform var(--transition-bounce), box-shadow var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
  }

  .clay-badge--link:hover {
    background: #ffffff;
    color: #0d281e;
    border-color: rgba(27, 107, 80, 0.3);
    transform: translateY(-1px);
    box-shadow: var(--shadow-clay);
  }

  .problem-nav {
    margin-top: var(--space-xl);
  }
</style>
