---
interface Props {
  code: string;
  language?: string;
  title?: string;
}

const { code, language = 'python', title } = Astro.props;
---

<div class="clay-code">
  <div class="clay-code__header">
    <span class="clay-code__lang">{title || language}</span>
    <button class="clay-code__copy" type="button" data-code={code}>📋 Copy</button>
  </div>
  <pre><code class={`language-${language}`}>{code}</code></pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.clay-code__copy').forEach((button) => {
    button.addEventListener('click', () => {
      const code = button.dataset.code ?? '';
      void navigator.clipboard.writeText(code);
      button.textContent = '✓ Copied!';
      window.setTimeout(() => {
        button.textContent = '📋 Copy';
      }, 1500);
    });
  });
</script>
